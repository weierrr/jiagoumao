# Local DEMO database. Never copy credentials from the parent project.
DATABASE_URL="file:./dev.db"
DRY_RUN="true"
EMAIL_PROVIDER="mock"
DEMO_MODE="true"
APP_URL="http://127.0.0.1:3100"
# Required outside loopback demo; set long independent random values.
ADMIN_PASSWORD=""
SESSION_SECRET=""
SHOPIFY_SHOP_DOMAIN=""
SHOPIFY_ACCESS_TOKEN=""
SHOPIFY_API_VERSION="2026-07"
SHOPIFY_WEBHOOK_SECRET=""
RESEND_API_KEY=""
RESEND_WEBHOOK_SECRET=""
RESEND_FROM=""
TEST_EMAIL_ALLOWLIST=""
# All gates default off. Never enable without the documented live acceptance tests.
POLICY_APPROVAL_REFERENCE=""
LIVE_INTEGRATION_VERIFIED="false"
AUTOMATION_EXIT_VERIFIED="false"
BILLING_VERIFIED="false"
ABANDONED_CHECKOUT_ENABLED="false"
